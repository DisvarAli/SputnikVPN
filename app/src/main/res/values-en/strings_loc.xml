    <string name="onboarding_welcome_title">Welcome to\nSputnik VPN</string>
    <string name="onboarding_welcome_body">Open VPN client: loads public configs via mirrors, lets you pick a server, and connects with Xray.</string>
    <string name="onboarding_owner">Project owner:</string>
    <string name="onboarding_inspiration">Inspiration (subscriptions):</string>
    <string name="onboarding_inspiration_hint">(Tap to open on GitHub)</string>
    <string name="onboarding_permissions_title">Permissions</string>
    <string name="onboarding_permissions_intro">The app needs the permissions below. We only request what is required.</string>
    <string name="onboarding_perm_vpn_title">VPN connection</string>
    <string name="onboarding_perm_vpn_body">Android permission to create a secure tunnel. Without it, traffic cannot go through the VPN. Requested on first Connect.</string>
    <string name="onboarding_perm_inet_title">Internet access</string>
    <string name="onboarding_perm_inet_body">Required to download configs from mirrors (GitLab, GitHack, etc.) and reach VPN servers.</string>
    <string name="onboarding_perm_notif_title">Notifications</string>
    <string name="onboarding_perm_notif_body">Show VPN status in the status bar: server country and traffic. Can be disabled in Android settings.</string>
    <string name="onboarding_perm_bg_title">Background operation</string>
    <string name="onboarding_perm_bg_body">The VPN service stays active in the background while connected so traffic is not interrupted.</string>
    <string name="onboarding_agreement_title">Terms of use</string>
    <string name="onboarding_agree_p1">Sputnik VPN is an educational project for accessing network resources where restrictions apply.</string>
    <string name="onboarding_agree_p2">The app loads public configs from mirrors of github.com/igareck/vpn-configs-for-russia. The maintainer (@DisvarAli) is not affiliated with subscription authors and does not operate third-party servers.</string>
    <string name="onboarding_agree_p3">We do not collect analytics or telemetry — settings and cache stay on your device.</string>
    <string name="onboarding_agree_p4">By using Sputnik VPN you understand that:</string>
    <string name="onboarding_agree_b1">• VPN must be used for lawful purposes only</string>
    <string name="onboarding_agree_b2">• Speed and stability depend on the server, carrier, and network blocks</string>
    <string name="onboarding_agree_b3">• Public configs are provided without stability guarantees</string>
    <string name="onboarding_agree_p5">By tapping Get started you accept these terms and use the app at your own risk.</string>

